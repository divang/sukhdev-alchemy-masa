VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
VITE_AUTH_REDIRECT_URL=https://YOUR_PUBLIC_SITE_URL/
VITE_CATALOG_CACHE_BUSTER=release-2026-06-02
